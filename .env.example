# Turnify environment variables (example values only — never commit real secrets).
# Copy to `.env` at the repository root:  cp .env.example .env

# --- API ---
NODE_ENV=development
PORT=4000
# PostgreSQL connection string. `npm run db:dev` starts a local ephemeral server on port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/turnify
# Long random string used to sign session tokens (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session lifetime in days
SESSION_TTL_DAYS=7
# Comma-separated list of allowed browser origins (only needed when the web app calls the API cross-origin)
CORS_ORIGINS=http://localhost:5173
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
# Set to "true" when the API runs behind a proxy/load balancer (Render, Vercel rewrites)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Web (development only) ---
# Where the Vite dev server proxies /api requests
API_PROXY_TARGET=http://localhost:4000
