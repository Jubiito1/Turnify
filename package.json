{
  "name": "turnify",
  "version": "1.0.0",
  "private": true,
  "description": "Turnify — appointment and service management SaaS for small businesses",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @turnify/api\" \"npm run dev -w @turnify/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:dev": "npm run db:dev -w @turnify/api",
    "db:migrate": "npm run db:migrate -w @turnify/api",
    "db:seed": "npm run db:seed -w @turnify/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
