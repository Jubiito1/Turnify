// Turnify data model. Business rules referenced as RN-XXX (see docs/SPEC.md).
// Constraints Prisma cannot express (CHECK, EXCLUDE) live in the `constraints` migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BusinessCategory {
  BEAUTY
  BARBERSHOP
  HEALTH
  WELLNESS
  FITNESS
  EDUCATION
  PETS
  OTHER
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Always stored lowercase (RN-031).
  email        String   @unique
  /// bcrypt hash. Null for guest clients created by an admin (they cannot log in).
  passwordHash String?
  name         String
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  ownedBusiness     Business?      @relation("BusinessOwner")
  professional      Professional?
  bookings          Booking[]      @relation("ClientBookings")
  cancelledBookings Booking[]      @relation("BookingCanceller")
  notifications     Notification[]
  createdBlocks     TimeBlock[]
}

model Business {
  id                   String           @id @default(uuid()) @db.Uuid
  ownerId              String           @unique @db.Uuid
  name                 String
  slug                 String           @unique
  description          String?
  category             BusinessCategory
  /// IANA time zone used to interpret working hours (RN-019).
  timezone             String
  address              String?
  phone                String?
  /// Minimum notice for client cancellation/reschedule (RN-013).
  cancellationMinHours Int              @default(24)
  /// Slot alignment step (RN-034).
  slotIntervalMinutes  Int              @default(15)
  /// How far ahead clients can book (RN-027).
  bookingHorizonDays   Int              @default(60)
  /// When true, client bookings are created CONFIRMED instead of PENDING.
  autoConfirm          Boolean          @default(false)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  owner         User           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  services      Service[]
  professionals Professional[]
  bookings      Booking[]

  @@index([category, isActive])
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  name            String
  description     String?
  /// Appointment length (RN-007).
  durationMinutes Int
  /// Integer cents (RN-018).
  priceCents      Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  bookings      Booking[]

  @@index([businessId, isActive])
}

model Professional {
  id                  String   @id @default(uuid()) @db.Uuid
  businessId          String   @db.Uuid
  /// Optional login account for the professional panel.
  userId              String?  @unique @db.Uuid
  displayName         String
  bio                 String?
  /// Deactivated instead of deleted to keep history (RN-023).
  isActive            Boolean  @default(true)
  /// Permissions granted by the admin (RN-033).
  canManageBlocks     Boolean  @default(false)
  canCompleteBookings Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ProfessionalService[]
  workingHours WorkingHours[]
  blocks       TimeBlock[]
  bookings     Booking[]

  @@index([businessId, isActive])
}

/// Which services a professional can perform (RN-003).
model ProfessionalService {
  professionalId String @db.Uuid
  serviceId      String @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

/// Weekly working ranges in local minutes of the business time zone (RN-004, RN-019, RN-030).
model WorkingHours {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  weekday        Int
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

/// Availability exceptions (RN-005, RN-029).
model TimeBlock {
  id             String   @id @default(uuid()) @db.Uuid
  professionalId String   @db.Uuid
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  reason         String?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([professionalId, startsAt])
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  businessId         String        @db.Uuid
  serviceId          String        @db.Uuid
  professionalId     String        @db.Uuid
  clientId           String        @db.Uuid
  startsAt           DateTime      @db.Timestamptz(3)
  /// Computed by the server from the service duration (RN-007).
  endsAt             DateTime      @db.Timestamptz(3)
  status             BookingStatus @default(PENDING)
  /// Price snapshot at booking time, integer cents (RN-018).
  priceCents         Int
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?     @db.Timestamptz(3)
  cancelledById      String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional  Professional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  client        User           @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Restrict)
  cancelledBy   User?          @relation("BookingCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([professionalId, startsAt])
  @@index([clientId, startsAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  bookingId String?          @db.Uuid
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
